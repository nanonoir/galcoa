# GALCOA+ — plantilla de entorno de producción (VPS / Docker). SIN secretos reales.
# En el VPS: cp .env.production.example .env.production && chmod 600 .env.production
# .env.production está ignorado por git y por .dockerignore (no entra a la imagen).

# --- Públicos (también se usan como build args: se incrustan en el bundle del navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Orígenes confiables para Auth (coma para varios). Debe coincidir con el dominio público.
NEXT_PUBLIC_APP_URL=https://galcoa.noirnahuel.com

# --- Solo servidor (runtime) ---
SUPABASE_SECRET_KEY=
GALCOA_EXECUTOR_DATABASE_URL=
# Opcional: CA PEM para la conexión del ejecutor
GALCOA_EXECUTOR_DATABASE_CA=

GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Hedera: solo testnet (INV-06)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
