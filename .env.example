
# ==================================================
# GALCOA+ — Environment Variables
# ==================================================

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==================================================
# SUPABASE — Auth, PostgreSQL, Storage
# ==================================================

# Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Optional for privileged operations.
# Never expose this key in the browser.
SUPABASE_SECRET_KEY=

# Storage: private bucket for documents/evidence
SUPABASE_STORAGE_BUCKET=documents

# ==================================================
# AI — Document generation and verification
# ==================================================

# OpenAI: primary document generation
OPENAI_API_KEY=

# Google Gemini: verification / alternative model
GOOGLE_GENERATIVE_AI_API_KEY=

# GroqCloud: alternative verification provider
GROQ_API_KEY=

# Default model selection (application-defined)
AI_GENERATOR_PROVIDER=openai
AI_VERIFIER_PROVIDER=google

# Set actual supported model IDs in application config.
# AI_GENERATOR_MODEL=
# AI_VERIFIER_MODEL=

# ==================================================
# HEDERA — Consensus Service (HCS)
# ==================================================

# testnet | mainnet
HEDERA_NETWORK=testnet

# Hedera operator account credentials — server only
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# Existing HCS topic ID; created during setup
HEDERA_TOPIC_ID=

# ==================================================
# MERCADO PAGO — Subscriptions (later phase)
# ==================================================

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ==================================================
# OPTIONAL — Stripe (future)
# ==================================================

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
