    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^30.1.3",
    "shadcn": "^4.21.5",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
