{
  "name": "galcoa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "env:check": "node scripts/env-file.mjs check",
    "env:install": "node scripts/env-file.mjs install",
    "predev": "npm run env:check",
    "dev": "next dev",
    "prebuild": "npm run env:check",
    "build": "next build",
    "prestart": "npm run env:check",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:boundaries": "vitest run --project boundaries",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:server:local": "vitest run --config vitest.server-local.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:auth": "node tests/server/auth-flow/run-local-auth.mjs",
    "test:e2e:confirm": "node tests/e2e/confirm/run.mjs",
    "preview:ui": "vite --config preview/vite.config.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/react": "^4.0.146",
